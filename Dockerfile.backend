FROM python:3.12-slim

WORKDIR /app

# Install system dependencies & docker CLI tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    pciutils \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt* ./
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    pydantic \
    psutil \
    docker \
    crewai \
    crewai-tools \
    langchain-google-genai \
    requests

COPY . .

EXPOSE 8000

CMD ["python", "main.py"]
